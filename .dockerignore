# The image builds the frontend itself; a host build would be copied over it and
# node_modules is 200 MB of layer for nothing.
app/node_modules
app/dist
# A host bundle must not enter the build context; the image gets its own copy
# from the frontend stage.
arena/frontend/
.venv
.git
__pycache__
**/__pycache__
*.pyc
docs/*
!docs/guides/
tests
.github
